APP_NAME=COSMOS X API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Runtime role (FastAPI)
DATABASE_URL=postgresql+psycopg://cosmosx_app:CHANGE_ME_APP_PASS@localhost:5432/cosmosx_dev

# Migration role (Alembic only)
MIGRATION_DATABASE_URL=postgresql+psycopg://cosmosx_migrator:CHANGE_ME_MIGRATOR_PASS@localhost:5432/cosmosx_dev

# Test database
TEST_DATABASE_URL=postgresql+psycopg://cosmosx_migrator:CHANGE_ME_MIGRATOR_PASS@localhost:5432/cosmosx_test
